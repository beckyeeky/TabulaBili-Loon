#!name = TabulaBili 初见哔哩 (Loon TF)
#!desc = TF 现代语法本地模板；请将 script("scripts/...") 路径改为设备可访问路径后导入。与所有远程入口只启用一个，勿重复启用。
#!author = beckyeeky
#!homepage = https://github.com/beckyeeky/TabulaBili-Loon
#!tag = Bilibili,推荐,信息茧房
#!system = iOS,iPadOS,macOS
#!system_version = 15
#!loon_version = 3.5.3(1007)
#!date = 2026-10-11

[Argument]
mode = select,"refresh","pure","mixed","origin",tag=推荐模式,desc=refresh=探索(buvid) | pure=纯净 | mixed=交替 | origin=关闭清洗
risk_notify = switch,true,tag=风控通知,desc=推荐接口异常时通知（30 分钟同类最多 1 次）
risk_debug = switch,false,tag=风控调试日志,desc=成功也打日志

[Rewrite]
# 只迁移无需签名/存储的 Web pure；不改 URL，保留 WBI query/signature。
request if ${mode} == "pure" && ${request.method} == "GET" && ${url} ~= /^https:\/\/api\.bilibili\.com\/x\/web-interface(?:\/wbi)?\/index\/top\/(?:feed\/)?rcmd(?:\?|$)/i then request.header.del(["Cookie", "Authorization", "x-bili-mid", "x-bili-aurora-eid", "x-bili-gaia-vtoken", "x-bili-ticket", "bili-ticket"])

[Script]
# GET 精确端点；origin 不执行清洗脚本。其余请求保持原样。
request if ${mode} ~= /^(refresh|pure|mixed)$/ && ${request.method} == "GET" && ${url} ~= /^https:\/\/(?:app\.bilibili\.com|app\.biliapi\.net)\/x\/v2\/feed\/index(?:\?|$)/i then script("scripts/tabulabili-rcmd.js", {${mode}}) with tag="TabulaBili App推荐清洗", timeout=10, requires_body=false
# 与 Web pure Rewrite 互斥，避免 Rewrite/Script 同时写 Cookie。
request if ${mode} ~= /^(refresh|mixed)$/ && ${request.method} == "GET" && ${url} ~= /^https:\/\/api\.bilibili\.com\/x\/web-interface(?:\/wbi)?\/index\/top\/(?:feed\/)?rcmd(?:\?|$)/i then script("scripts/tabulabili-rcmd.js", {${mode}}) with tag="TabulaBili Web推荐清洗", timeout=10, requires_body=false
request if ${url} ~= /^https:\/\/(?:app\.bilibili\.com|app\.biliapi\.net|api\.bilibili\.com)\/(?!x\/v2\/feed\/index(?:\?|$)|x\/web-interface(?:\/wbi)?\/index\/top\/(?:feed\/)?rcmd(?:\?|$))/i then script("scripts/tabulabili-capture.js") with tag="TabulaBili指纹采集", timeout=5, requires_body=false
# 不加 status/Content-Type 门槛：保留非 JSON/错误响应的 skip 诊断。
response if ${request.method} == "GET" && ${url} ~= /^https:\/\/(?:app\.bilibili\.com|app\.biliapi\.net)\/x\/v2\/feed\/index(?:\?|$)/i then script("scripts/tabulabili-risk.js", {${risk_notify}, ${risk_debug}}) with tag="TabulaBili App风控探针", timeout=10, requires_body=true
response if ${request.method} == "GET" && ${url} ~= /^https:\/\/api\.bilibili\.com\/x\/web-interface(?:\/wbi)?\/index\/top\/(?:feed\/)?rcmd(?:\?|$)/i then script("scripts/tabulabili-risk.js", {${risk_notify}, ${risk_debug}}) with tag="TabulaBili Web风控探针", timeout=10, requires_body=true

[MitM]
hostname = app.bilibili.com, app.biliapi.net, api.bilibili.com
